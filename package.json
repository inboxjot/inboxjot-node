{
  "name": "inboxjot",
  "version": "0.1.0",
  "description": "The official Node.js SDK for the Inboxjot email API",
  "license": "MIT",
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inboxjot/inboxjot-node.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "generate": "node scripts/generate.mjs",
    "prepare": "vp config",
    "prepublishOnly": "vp check && vp test run && vp pack",
    "release": "bumpp package.json src/inboxjot.ts",
    "test": "vp test run"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "spectype": "^0.1.0",
    "typescript": "^5.9.3",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.18.0"
}
